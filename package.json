{
  "name": "@prefactor/sdk-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "changeset": "changeset",
    "docs:typedoc": "typedoc --options typedoc.json",
    "versions:check": "bun run scripts/generate-versions.ts --check",
    "release:cli:stable": "bun run scripts/release-cli-stable.ts",
    "release:version": "bun run scripts/sync-release-metadata.ts",
    "release:npm": "bun run scripts/release-publish.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "example:langchain": "bun examples/langchain/simple-agent.ts",
    "example:langchain-termination": "bun examples/langchain/termination-demo.ts",
    "example:livekit": "bun examples/livekit/simple-session.ts",
    "example:ai": "bun examples/ai-sdk/simple-agent.ts",
    "example:ai-schema": "bun examples/ai-sdk/custom-schema.ts",
    "example:pi": "bun examples/pi/print-mode.ts",
    "example:pi-sdk": "bun examples/pi/sdk-agent.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "@biomejs/biome": "2.6.8",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@langchain/anthropic": "^1.6.6",
    "@langchain/core": "^1.5.1",
    "@livekit/agents": "^1.10.1",
    "@prefactor/ai": "workspace:*",
    "@prefactor/claude": "workspace:*",
    "@prefactor/core": "workspace:*",
    "@prefactor/langchain": "workspace:*",
    "@prefactor/livekit": "workspace:*",
    "@prefactor/pi": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^22.20.5",
    "ai": "^7.0.181",
    "bun-types": "1.3.14",
    "langchain": "^1.6.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "form-data": "4.0.6",
    "ws": "8.23.0",
    "langsmith": "0.8.12",
    "sharp": "0.35.5",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14"
  }
}
