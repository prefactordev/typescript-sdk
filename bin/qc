#!/usr/bin/env bash
# Run preflight checks (bin/preflight), then the test suite (bun test).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/interrupt.sh
source "$ROOT/bin/lib/interrupt.sh"
cd "$ROOT"

# Load mise environment so bun and other tools are available
eval "$(mise activate bash)"

# Merge stderr into stdout so IDE/agent terminals capture full output without appending 2>&1.
exec 2>&1

usage() {
  cat <<'EOF'
Usage: bin/qc [bun test args...]

Run preflight checks (bin/preflight), then the test suite (bun test).
All arguments are passed through to bun test:

Examples:
  bin/qc
  bin/qc packages/core/tests/
  bin/qc --test-name-pattern "finishes the span"
EOF
}

case "${1:-}" in
  help|--help|-h)
    usage
    exit 0
  ;;
esac

"$ROOT/bin/preflight"
exec bun test "$@"
