  },
  "dependencies": {
    "@prefactor/pfid": "^0.1.0"
  },
  "peerDependencies": {
    "@prefactor/core": "^1.0.0",
    "ai": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "engines": {
    "node": ">=22.0.0"
  }
